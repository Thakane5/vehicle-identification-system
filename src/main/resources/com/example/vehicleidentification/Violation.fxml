<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.vehicleidentification.controllers.ViolationController"
      stylesheets="@styles.css" spacing="0" minWidth="1200" minHeight="700"
      style="-fx-background-color: transparent;">

    <MenuBar styleClass="menu-bar">
        <Menu text="File"><MenuItem text="Exit" onAction="#handleExit"/></Menu>
        <Menu text="Modules">
            <MenuItem text="Dashboard"       onAction="#goToDashboard"/>
            <MenuItem text="Vehicles"        onAction="#goToVehicle"/>
            <MenuItem text="Customer Panel"  onAction="#goToCustomer"/>
            <MenuItem text="Workshop"        onAction="#goToWorkshop"/>
            <MenuItem text="Police"          onAction="#goToPolice"/>
            <MenuItem text="Violation"       onAction="#goToViolations"/>
            <MenuItem text="Insurance"       onAction="#goToInsurance"/>
            <MenuItem text="User Management" onAction="#goToAdmin"/>
        </Menu>
    </MenuBar>

    <HBox styleClass="header" alignment="CENTER_LEFT" spacing="15">
        <VBox>
            <Label text="VehicleID System" styleClass="header-logo"/>
            <Label text="Violations Panel" styleClass="header-subtitle"/>
        </VBox>
        <HBox HBox.hgrow="ALWAYS"/>
        <Label fx:id="welcomeLabel"
               style="-fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 0 10 0 0;"/>
        <Button text="Dashboard"       styleClass="nav-btn" onAction="#goToDashboard"/>
        <Button text="Vehicles"        styleClass="nav-btn" onAction="#goToVehicle"/>
        <Button text="Customer Panel"  styleClass="nav-btn" onAction="#goToCustomer"/>
        <Button text="Workshop"        styleClass="nav-btn" onAction="#goToWorkshop"/>
        <Button text="Police"          styleClass="nav-btn" onAction="#goToPolice"/>
        <Button text="Violation"       styleClass="nav-btn nav-btn-active" onAction="#goToViolations"/>
        <Button text="Insurance"       styleClass="nav-btn" onAction="#goToInsurance"/>
        <Button text="User Management" styleClass="nav-btn" onAction="#goToAdmin"/>
        <Button fx:id="logoutButton"   styleClass="btn-danger" onAction="#handleLogout"
                text="Logout"/>
    </HBox>

    <!-- ACCESS DENIED -->
    <VBox fx:id="accessDeniedPane" alignment="CENTER" spacing="20"
          style="-fx-padding: 80; -fx-background-color: #ffebee;"
          VBox.vgrow="ALWAYS" visible="false" managed="false">
        <Label text="Access Denied"
               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #c62828;"/>
        <Button text="Go Back to Dashboard" styleClass="btn-danger" onAction="#goToDashboard"/>
    </VBox>

    <!-- CUSTOMER PANE — read-only, own violations only -->
    <VBox fx:id="customerPane" spacing="15" style="-fx-padding: 20;"
          VBox.vgrow="ALWAYS" visible="false" managed="false">
        <Label text="My Violations" styleClass="page-title"/>
        <Label text="Read-only view of your own violations."
               style="-fx-text-fill: #757575; -fx-font-size: 12px;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Show Unpaid" styleClass="btn-danger"  onAction="#handleFilterUnpaid"/>
            <Button text="Show All"    styleClass="btn-primary" onAction="#handleShowAll"/>
            <Label fx:id="customerMessageLabel" text=""
                   style="-fx-text-fill: #c62828; -fx-font-size: 12px;"/>
        </HBox>
        <TableView fx:id="customerViolationTable" VBox.vgrow="ALWAYS" prefHeight="500"
                   styleClass="table-view">
            <columns>
                <TableColumn fx:id="cColDate"    text="Date"        prefWidth="110"/>
                <TableColumn fx:id="cColVehicle" text="Vehicle Reg" prefWidth="130"/>
                <TableColumn fx:id="cColType"    text="Type"        prefWidth="140"/>
                <TableColumn fx:id="cColFine"    text="Fine (M)"    prefWidth="120"/>
                <TableColumn fx:id="cColStatus"  text="Status"      prefWidth="100"/>
            </columns>
            <placeholder><Label text="No violations found."/></placeholder>
        </TableView>
    </VBox>

    <!-- ADMIN VIEW-ONLY PANE -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="adminViewPane" spacing="0" visible="false" managed="false"
              style="-fx-background-color: transparent;">

            <!-- View-only notice banner -->
            <VBox fx:id="adminViewOnlyNotice"
                  style="-fx-background-color:#e3f2fd;-fx-padding:12 20;
                         -fx-border-color:#90caf9;-fx-border-width:0 0 1 0;">
                <Label text="View Only Mode — Admins can view all violations but cannot add, update or delete."
                       style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1565c0;"/>
            </VBox>

            <!-- Summary cards -->
            <HBox spacing="20" style="-fx-padding: 15 20 5 20;" alignment="CENTER_LEFT">
                <VBox styleClass="card" alignment="CENTER" spacing="4"
                      style="-fx-min-width: 140; -fx-padding: 12;">
                    <Label text="Total Violations"
                           style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                    <Label fx:id="adminTotalLabel" text="0"
                           style="-fx-font-size: 26px; -fx-font-weight: bold;
                                  -fx-text-fill: #1565c0;"/>
                </VBox>
                <VBox styleClass="card" alignment="CENTER" spacing="4"
                      style="-fx-min-width: 140; -fx-padding: 12;">
                    <Label text="Unpaid"
                           style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                    <Label fx:id="adminUnpaidLabel" text="0"
                           style="-fx-font-size: 26px; -fx-font-weight: bold;
                                  -fx-text-fill: #c62828;"/>
                </VBox>
                <VBox styleClass="card" alignment="CENTER" spacing="4"
                      style="-fx-min-width: 140; -fx-padding: 12;">
                    <Label text="Paid"
                           style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                    <Label fx:id="adminPaidLabel" text="0"
                           style="-fx-font-size: 26px; -fx-font-weight: bold;
                                  -fx-text-fill: #2e7d32;"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="All"    styleClass="btn-primary" onAction="#handleAdminShowAll"/>
                <Button text="Unpaid" styleClass="btn-danger"  onAction="#handleAdminFilterUnpaid"/>
                <Button text="Paid"   styleClass="btn-primary" onAction="#handleAdminFilterPaid"/>
            </HBox>

            <!-- Search -->
            <HBox spacing="10" style="-fx-padding: 5 20 10 20;" alignment="CENTER_LEFT">
                <TextField fx:id="adminSearchField"
                           promptText="Search by vehicle reg, type, officer or location..."
                           styleClass="form-field" HBox.hgrow="ALWAYS"/>
                <Button text="Search" styleClass="btn-primary" onAction="#handleAdminSearch"/>
                <Button text="Clear" onAction="#handleAdminClearSearch"
                        style="-fx-background-color:#eceff1;-fx-text-fill:#424242;
                               -fx-font-size:13px;-fx-padding:9 20;
                               -fx-background-radius:5;-fx-cursor:hand;
                               -fx-font-weight:bold;"/>
            </HBox>

            <VBox spacing="10" style="-fx-padding: 0 20 20 20;">
                <Label text="All Violations (View Only)" styleClass="page-title"
                       style="-fx-text-fill: white;"/>
                <TableView fx:id="adminViolationTable" VBox.vgrow="ALWAYS" prefHeight="600"
                           styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="aColId"         text="ID"          prefWidth="50"/>
                        <TableColumn fx:id="aColVehicleReg" text="Vehicle Reg" prefWidth="130"/>
                        <TableColumn fx:id="aColDate"       text="Date"        prefWidth="110"/>
                        <TableColumn fx:id="aColType"       text="Type"        prefWidth="120"/>
                        <TableColumn fx:id="aColDesc"       text="Description" prefWidth="180"/>
                        <TableColumn fx:id="aColFine"       text="Fine (M)"    prefWidth="90"/>
                        <TableColumn fx:id="aColStatus"     text="Status"      prefWidth="90"/>
                        <TableColumn fx:id="aColOfficer"    text="Officer"     prefWidth="120"/>
                        <TableColumn fx:id="aColLocation"   text="Location"    prefWidth="130"/>
                    </columns>
                    <placeholder><Label text="No violations found."/></placeholder>
                </TableView>
                <Label fx:id="adminTableMessageLabel" text="" wrapText="true"/>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- MAIN CONTENT (POLICE only — full access) -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="mainContentPane" spacing="0" visible="false" managed="false"
              style="-fx-background-color: transparent;">

            <!-- Summary Cards -->
            <HBox spacing="20" style="-fx-padding: 15 20 5 20;" alignment="CENTER_LEFT">
                <VBox styleClass="card" alignment="CENTER" spacing="4"
                      style="-fx-min-width: 140; -fx-padding: 12;">
                    <Label text="Total Violations"
                           style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                    <Label fx:id="totalViolationsLabel" text="0"
                           style="-fx-font-size: 26px; -fx-font-weight: bold;
                                  -fx-text-fill: #1565c0;"/>
                </VBox>
                <VBox styleClass="card" alignment="CENTER" spacing="4"
                      style="-fx-min-width: 140; -fx-padding: 12;">
                    <Label text="Unpaid"
                           style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                    <Label fx:id="unpaidLabel" text="0"
                           style="-fx-font-size: 26px; -fx-font-weight: bold;
                                  -fx-text-fill: #c62828;"/>
                </VBox>
                <VBox styleClass="card" alignment="CENTER" spacing="4"
                      style="-fx-min-width: 140; -fx-padding: 12;">
                    <Label text="Paid"
                           style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                    <Label fx:id="paidLabel" text="0"
                           style="-fx-font-size: 26px; -fx-font-weight: bold;
                                  -fx-text-fill: #2e7d32;"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="All"    styleClass="btn-primary" onAction="#handleShowAll"/>
                <Button text="Unpaid" styleClass="btn-danger"  onAction="#handleFilterUnpaid"/>
                <Button text="Paid"   styleClass="btn-primary" onAction="#handleFilterPaid"/>
            </HBox>

            <!-- Search Bar -->
            <HBox spacing="10" style="-fx-padding: 5 20 10 20;" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="Search by vehicle reg, type, officer or location..."
                           styleClass="form-field" HBox.hgrow="ALWAYS"/>
                <Button text="Search" styleClass="btn-primary" onAction="#handleSearch"/>
                <Button text="Clear" onAction="#handleClearSearch"
                        style="-fx-background-color:#eceff1;-fx-text-fill:#424242;
                               -fx-font-size:13px;-fx-padding:9 20;
                               -fx-background-radius:5;-fx-cursor:hand;
                               -fx-font-weight:bold;"/>
            </HBox>

            <HBox spacing="20" style="-fx-padding: 0 20 20 20;" VBox.vgrow="ALWAYS">

                <!-- LEFT: FORM — Police only -->
                <ScrollPane fitToWidth="true" prefWidth="340"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;">
                    <VBox spacing="12" styleClass="card" prefWidth="320">
                        <Label text="Violation Form" styleClass="page-title"/>

                        <Label text="Vehicle"          styleClass="form-label"/>
                        <ComboBox fx:id="vehicleCombo" promptText="Select vehicle..."
                                  styleClass="form-field" maxWidth="Infinity"/>
                        <Label fx:id="vehicleInfoLabel" text=""
                               style="-fx-font-size: 11px; -fx-text-fill: #5c6bc0;"
                               wrapText="true"/>

                        <Label text="Date"             styleClass="form-label"/>
                        <DatePicker fx:id="violationDatePicker" styleClass="form-field"
                                    maxWidth="Infinity"/>

                        <Label text="Violation Type"   styleClass="form-label"/>
                        <ComboBox fx:id="violationTypeCombo" styleClass="form-field"
                                  promptText="Select type" maxWidth="Infinity"/>

                        <Label text="Description"      styleClass="form-label"/>
                        <TextArea fx:id="descriptionField"
                                  promptText="Describe the violation..."
                                  prefHeight="60" wrapText="true"
                                  style="-fx-border-color: #c5cae9; -fx-border-radius: 5;
                                         -fx-background-radius: 5; -fx-font-size: 13px;"/>

                        <Label text="Fine Amount (M)"  styleClass="form-label"/>
                        <TextField fx:id="fineField"   promptText="0.00"
                                   styleClass="form-field"/>

                        <Label text="Officer Name"     styleClass="form-label"/>
                        <TextField fx:id="officerField" promptText="Officer name"
                                   styleClass="form-field"/>

                        <Label text="Location"         styleClass="form-label"/>
                        <TextField fx:id="locationField" promptText="Location"
                                   styleClass="form-field"/>

                        <Label text="Status"           styleClass="form-label"/>
                        <ComboBox fx:id="statusCombo"  styleClass="form-field"
                                  promptText="Paid / Unpaid" maxWidth="Infinity"/>

                        <Separator/>

                        <HBox spacing="8">
                            <Button text="Add" styleClass="btn-primary"
                                    onAction="#handleAdd"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Update" styleClass="btn-primary"
                                    onAction="#handleUpdate"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button fx:id="btnDelete" text="Delete" styleClass="btn-danger"
                                    onAction="#handleDelete"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>

                        <Button text="Mark as Paid" styleClass="btn-primary"
                                onAction="#handleMarkPaid" maxWidth="Infinity"/>

                        <Button text="Clear Form" onAction="#handleClear"
                                maxWidth="Infinity"
                                style="-fx-background-color:#eceff1;-fx-text-fill:#424242;
                                       -fx-font-size:13px;-fx-padding:9 20;
                                       -fx-background-radius:5;-fx-cursor:hand;
                                       -fx-font-weight:bold;"/>

                        <Label fx:id="messageLabel" text="" wrapText="true"/>
                    </VBox>
                </ScrollPane>

                <!-- RIGHT: TABLE -->
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="All Violations" styleClass="page-title"
                           style="-fx-text-fill: white;"/>
                    <TableView fx:id="violationTable" VBox.vgrow="ALWAYS" prefHeight="600"
                               styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colId"         text="ID"          prefWidth="50"/>
                            <TableColumn fx:id="colVehicleReg" text="Vehicle Reg" prefWidth="130"/>
                            <TableColumn fx:id="colDate"       text="Date"        prefWidth="110"/>
                            <TableColumn fx:id="colType"       text="Type"        prefWidth="120"/>
                            <TableColumn fx:id="colDesc"       text="Description" prefWidth="180"/>
                            <TableColumn fx:id="colFine"       text="Fine (M)"    prefWidth="90"/>
                            <TableColumn fx:id="colStatus"     text="Status"      prefWidth="90"/>
                            <TableColumn fx:id="colOfficer"    text="Officer"     prefWidth="120"/>
                            <TableColumn fx:id="colLocation"   text="Location"    prefWidth="130"/>
                        </columns>
                        <placeholder><Label text="No violations found."/></placeholder>
                    </TableView>
                    <Label fx:id="tableMessageLabel" text="" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>